// 复制为 Secrets.xcconfig（已被 .gitignore 排除）并填写。
// xcconfig 中 "//" 会被当成注释，URL 里的 // 要写成 /$()/
//
// 线上 Supabase：
//   SUPABASE_URL = https:/$()/<project-ref>.supabase.co
// 本地开发（supabase start，端口见 supabase/config.toml；仅模拟器可用）：
//   SUPABASE_URL = http:/$()/127.0.0.1:54421
SUPABASE_URL = https:/$()/your-project-ref.supabase.co

// anon / publishable key（可以公开，有 RLS 保护）。绝不要填 service_role 密钥。
SUPABASE_ANON_KEY = your-anon-key

// 真机安装需要的开发者团队 ID（Xcode → Settings → Accounts 中查看，10 位字母数字）
// DEVELOPMENT_TEAM = ABCDE12345

// 可选：模拟器连本地、真机连线上（真机访问不到 Mac 上的 127.0.0.1）
//   SUPABASE_URL = http:/$()/127.0.0.1:54421
//   SUPABASE_ANON_KEY = <本地 anon key>
//   SUPABASE_URL[sdk=iphoneos*] = https:/$()/<project-ref>.supabase.co
//   SUPABASE_ANON_KEY[sdk=iphoneos*] = <线上 anon / publishable key>
